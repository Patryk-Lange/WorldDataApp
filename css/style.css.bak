/* ============================================================
   GDP World Map – style.css
   ============================================================ */

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:        #0f172a;
  --surface:   #1e293b;
  --surface2:  #263244;
  --border:    #334155;
  --text:      #e2e8f0;
  --text-muted:#94a3b8;
  --accent:    #38bdf8;
  --selected:  #f59e0b;
  --radius:    10px;
  --sidebar-w: 320px;
}

html, body {
  height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
  font-size: 14px;
  overflow: hidden;
}

/* ── Layout ─────────────────────────────────────────────── */
#app {
  display: flex;
  flex-direction: column;
  height: 100%;
}

header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 10px 20px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  z-index: 10;
}

header h1 {
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: .02em;
  margin: 0;
}

header p {
  font-size: 0.8rem;
  color: var(--text-muted);
  margin: 0;
  flex-grow: 1;
}

.mode-toggle {
  display: flex;
  gap: 6px;
  background: var(--surface2);
  padding: 4px;
  border-radius: 6px;
  border: 1px solid var(--border);
}

.mode-btn {
  padding: 6px 12px;
  border: none;
  background: transparent;
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 600;
  border-radius: 4px;
  cursor: pointer;
  transition: all .15s;
}

.mode-btn:hover {
  color: var(--text);
}

.mode-btn.active {
  background: var(--accent);
  color: white;
}

main {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* ── Map ─────────────────────────────────────────────────── */
#map-container {
  flex: 1;
  position: relative;
  overflow: hidden;
}

#world-map {
  display: block;
  width: 100%;
  height: 100%;
}

.graticule {
  fill: none;
  stroke: #1e3a5f;
  stroke-width: 0.3px;
}

.borders {
  fill: none;
  stroke: #1f2937;
  stroke-width: 0.5px;
  pointer-events: none;
}

path.country {
  transition: opacity 0.2s ease;
}

path.country.no-data {
  opacity: 0.55;
}

path.country:hover {
  filter: brightness(1.35);
}

path.country.no-data:hover {
  opacity: 0.75;
  filter: brightness(1.2);
}

/* ── Tooltip ─────────────────────────────────────────────── */
#tooltip {
  display: none;
  position: absolute;
  top: 0; left: 0;
  background: rgba(15, 23, 42, 0.92);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 7px 12px;
  font-size: 12px;
  color: var(--text);
  pointer-events: none;
  white-space: nowrap;
  z-index: 100;
  backdrop-filter: blur(4px);
  line-height: 1.5;
}

#tooltip strong { color: var(--accent); }

#tooltip .no-data-tooltip {
  color: #fca5a5;
  font-weight: 600;
}

/* ── Sidebar ─────────────────────────────────────────────── */
#info-panel {
  width: var(--sidebar-w);
  flex-shrink: 0;
  background: var(--surface);
  border-left: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  overflow-x: hidden;
}

/* ── Detail card ─────────────────────────────────────────── */
#detail-card {
  padding: 20px 16px 16px;
  border-bottom: 1px solid var(--border);
  min-height: 190px;
}

.hint-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 24px 0;
  text-align: center;
  color: var(--text-muted);
  gap: 8px;
}

.hint-icon { font-size: 2.5rem; line-height: 1; }

.hint-sub {
  font-size: 11px;
  color: #475569;
  margin-top: 4px;
}

.detail-header {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-bottom: 14px;
}

.country-code {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .1em;
  color: var(--text-muted);
  text-transform: uppercase;
}

.country-name {
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--text);
  line-height: 1.2;
}

.metric-label {
  font-size: 11px;
  font-weight: 500;
  color: var(--accent);
  text-transform: uppercase;
  letter-spacing: .08em;
  margin-top: 4px;
}

.rank-badge {
  display: inline-block;
  background: #1e3a5f;
  color: var(--accent);
  font-size: 11px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 20px;
  border: 1px solid #2563eb44;
  width: fit-content;
}

.gdp-value {
  font-size: 1.8rem;
  font-weight: 800;
  color: var(--selected);
  line-height: 1;
  margin-bottom: 10px;
}

.gdp-value .unit {
  font-size: 0.75rem;
  font-weight: 400;
  color: var(--text-muted);
}

.gdp-share {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.share-bar-bg {
  height: 6px;
  background: var(--surface2);
  border-radius: 3px;
  overflow: hidden;
}

.share-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #0ea5e9, var(--selected));
  border-radius: 3px;
  transition: width 0.4s ease;
  min-width: 1px;
}

.share-label {
  font-size: 11px;
  color: var(--text-muted);
}

.no-data-msg {
  color: var(--text-muted);
  font-style: italic;
  margin-top: 8px;
}

.error {
  color: #f87171;
}

.deselect-btn {
  margin-top: 14px;
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text-muted);
  padding: 5px 12px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 12px;
  transition: border-color .2s, color .2s;
}

.deselect-btn:hover {
  border-color: #f87171;
  color: #f87171;
}

/* ── Legend ──────────────────────────────────────────────── */
#legend {
  padding: 16px 16px 12px;
  border-bottom: 1px solid var(--border);
}

#legend h4 {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: .06em;
  margin-bottom: 8px;
}

#legend svg { overflow: visible; }

.legend-no-data {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 8px;
  margin-bottom: 14px;
  font-size: 11px;
  color: var(--text-muted);
}

.nd-swatch {
  width: 14px; height: 14px;
  background: #374151;
  border-radius: 3px;
  border: 1px solid var(--border);
  flex-shrink: 0;
}

/* ── Top economies ───────────────────────────────────────── */
#top-economies {
  padding: 16px;
  flex: 1;
}

#top-economies h3 {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: var(--text-muted);
  margin-bottom: 10px;
}

#top-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

#top-list li {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 10px;
  border-radius: 6px;
  cursor: pointer;
  transition: background .15s;
  counter-increment: top-counter;
}

#top-list li::before {
  content: counter(top-counter);
  font-size: 10px;
  font-weight: 700;
  color: #475569;
  min-width: 16px;
  margin-right: 6px;
}

#top-list { counter-reset: top-counter; }

#top-list li:hover {
  background: var(--surface2);
}

.top-name {
  flex: 1;
  font-size: 12px;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 8px;
}

.top-val {
  font-size: 11px;
  color: var(--accent);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

/* ── Scrollbar ───────────────────────────────────────────── */
#info-panel::-webkit-scrollbar { width: 4px; }
#info-panel::-webkit-scrollbar-track { background: transparent; }
#info-panel::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

/* ── Responsive ──────────────────────────────────────────── */
@media (max-width: 640px) {
  main { flex-direction: column; }
  #map-container { flex: none; height: 60vh; }
  #info-panel {
    width: 100%;
    border-left: none;
    border-top: 1px solid var(--border);
    max-height: 40vh;
  }
}
